STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_SUBSCRIPTION_ID=
STRAVA_VERIFY_TOKEN=
WEBHOOK_PATH_SECRET=
# 32 random bytes represented as exactly 64 hexadecimal characters.
TOKEN_ENCRYPTION_KEY=
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=
# Optional in production when FatSecret requires a fixed outbound IP.
FATSECRET_PROXY_URL=https://your-proxy.fly.dev
FATSECRET_PROXY_SECRET=replace-with-a-long-random-secret
# Optional identifiable User-Agent override for Open Food Facts barcode lookups.
OPEN_FOOD_FACTS_USER_AGENT=
# Growth account verification, email changes, and password recovery.
# Use a sender on a domain verified with Resend. Never use EXPO_PUBLIC_ for these.
RESEND_API_KEY=
EMAIL_FROM=
