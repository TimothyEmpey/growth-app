{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "growth-journal",
  "main": "index.ts",
  "compatibility_date": "2026-09-19",
  "assets": { "directory": "../dist", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "growth-journal", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "growth-sync" }],
    "consumers": [{ "queue": "growth-sync", "max_batch_size": 1, "max_concurrency": 1, "max_retries": 100, "retry_delay": 60, "dead_letter_queue": "growth-sync-failed" }]
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": { "APP_ORIGIN": "http://localhost:8787", "DEV_CLIENT_ORIGIN": "http://localhost:8081" }
}
