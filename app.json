{
  "expo": {
    "name": "Growth",
    "slug": "Growth",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./public/icons/icon-512.png",
    "scheme": "growth",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.timempey.growth",
      "icon": "./public/icons/icon-512.png",
      "entitlements": {
        "com.apple.developer.healthkit": true
      },
      "infoPlist": {
        "NSHealthShareUsageDescription": "Growth reads running workouts and body-weight measurements you choose to import from Apple Health.",
        "NSHealthUpdateUsageDescription": "Growth does not write data to Apple Health; this description supports its read-only HealthKit integration."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./public/icons/icon-192.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121c31",
          "image": "./public/icons/icon-512.png",
          "imageWidth": 430
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Growth to scan food barcodes.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f13d7bc4-9adc-41c6-a747-9028cc143770"
      }
    },
    "owner": "empey"
  }
}
